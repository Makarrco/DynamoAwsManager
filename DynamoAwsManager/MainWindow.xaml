<Window x:Class="DynamoAwsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DynamoDB AWS Manager"
        Height="740" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush"  Color="#1E293B"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#94A3B8"/>

        <!-- Base button style -->
        <Style TargetType="Button">
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Background"      Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.82"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"               Value="#0F172A"/>
            <Setter Property="Foreground"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#334155"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground"  Value="#CBD5E1"/>
            <Setter Property="Padding"     Value="12,8"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="0,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3B82F6"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ LEFT PANEL ══════════ -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="16"
                Padding="14" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="DynamoDB AWS"
                               FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Manager"
                               Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="New Table"
                            Background="#10B981" Height="32" Margin="0,0,4,0"
                            Padding="0,0" Click="NewTable_Click"/>
                    <Button Grid.Column="1" x:Name="DropTableButton"
                            Content="Drop" Background="#EF4444"
                            Height="32" Margin="4,0,0,0"
                            Padding="0,0" IsEnabled="False" Click="DropTable_Click"/>
                </Grid>

                <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Padding="4">
                    <ListBox x:Name="TablesListBox"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="TablesListBox_SelectionChanged"/>
                </Border>

                <Button Grid.Row="3" Content="⟳  Refresh Tables"
                        Background="#334155" Height="32"
                        Padding="0,0" Margin="0,10,0,0"
                        Click="RefreshTables_Click"/>
            </Grid>
        </Border>

        <!-- ══════════ RIGHT AREA ══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="170"/>
            </Grid.RowDefinitions>

            <!-- ── TOOLBAR ── single unified bar, everything on same baseline ── -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="14"
                    Margin="0,0,0,10"
                    Height="60">

                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- table name -->
                        <ColumnDefinition Width="*"/>
                        <!-- spacer -->
                        <ColumnDefinition Width="200"/>
                        <!-- search -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- action buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Table title -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TableTitleBlock"
                                   Text="← Select a table"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock x:Name="TableInfoBlock" Text=""
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"/>
                    </StackPanel>

                    <!-- Search box -->
                    <Grid Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBox x:Name="SearchBox"
                                 Height="34"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Text="🔍  Search..."
                                   Foreground="#475569"
                                   FontSize="13"
                                   Padding="10,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Action buttons — all same height, vertically centered -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Button x:Name="AddItemButton"
                                Content="＋ Add"
                                Width="80" Height="34" Padding="0,0"
                                Background="#10B981" Margin="0,0,6,0"
                                IsEnabled="False" Click="AddItem_Click"/>

                        <Button x:Name="EditItemButton"
                                Content="✎ Edit"
                                Width="74" Height="34" Padding="0,0"
                                Background="#F59E0B" Margin="0,0,6,0"
                                IsEnabled="False" Click="EditItem_Click"/>

                        <Button x:Name="DeleteItemButton"
                                Content="✕ Delete"
                                Width="80" Height="34" Padding="0,0"
                                Background="#EF4444" Margin="0,0,6,0"
                                IsEnabled="False" Click="DeleteItem_Click"/>

                        <Button x:Name="RefreshItemsButton"
                                Content="⟳ Refresh"
                                Width="88" Height="34" Padding="0,0"
                                Background="#334155"
                                IsEnabled="False" Click="RefreshItems_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── DataGrid ── -->
            <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                    CornerRadius="14" Padding="14">
                <DataGrid x:Name="ItemsDataGrid"
                          Background="#0F172A" Foreground="White"
                          BorderThickness="0" GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowBackground="#1E293B" AlternatingRowBackground="#273449"
                          AutoGenerateColumns="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          SelectionChanged="ItemsDataGrid_SelectionChanged">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"      Value="#334155"/>
                            <Setter Property="Foreground"      Value="White"/>
                            <Setter Property="FontWeight"      Value="Bold"/>
                            <Setter Property="Padding"         Value="10,7"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </DataGrid.Resources>
                </DataGrid>
            </Border>

            <!-- ── Logs ── -->
            <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                    CornerRadius="14" Padding="14" Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Activity Log"
                                   FontSize="13" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <Button Content="Clear" Width="56" Height="24"
                                FontSize="11" Padding="0,0"
                                Background="#334155" HorizontalAlignment="Right"
                                DockPanel.Dock="Right" Click="ClearLog_Click"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" x:Name="LogScrollViewer"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="LogTextBlock"
                                   Foreground="#64748B" FontFamily="Consolas"
                                   FontSize="11.5" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
